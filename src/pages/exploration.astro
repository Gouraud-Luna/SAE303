---
import Layout from "../layouts/Layout.astro";
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
import "leaflet/dist/leaflet.css";
import installationsData from "../assets/installationindugironde.json";

const bordeauxCode = 33063;
const installations = installationsData
  .filter((installation) => String(installation.cd_insee) === String(bordeauxCode))
  .map(({ x, y, nom_ets, lib_naf, lib_regime, adresse }) => ({
    x,
    y,
    nom_ets,
    lib_naf,
    lib_regime,
    adresse: adresse || "Adresse non renseignée",
  }));

const sectors = Object.entries(
  installations.reduce((counts, installation) => {
    const sector = installation.lib_naf || "Secteur non renseigné";
    counts[sector] = (counts[sector] || 0) + 1;
    return counts;
  }, {}),
)
  .map(([sector, count]) => ({ sector, count }))
  .sort((a, b) => b.count - a.count)
  .slice(0, 10);
---

<script>
  import L from "leaflet";
  import proj4 from "proj4";

  type ApiZone = {
    insee?: string | number;
    geo_shape?: unknown;
    delta?: number | string | null;
    date_releve?: string;
    gid?: string | number;
  };

  type HeatProperties = {
    valeur: number;
    commune: string;
    date: string;
    identifiant: string;
  };

  const communes = [
    { code: "33063", nom: "Bordeaux" },
    { code: "33069", nom: "Le Bouscat" },
    { code: "33075", nom: "Bruges" },
  ];

  const maps = new Map<HTMLElement, L.Map>();
  const installationMaps = new Map<HTMLElement, L.Map>();

  proj4.defs(
    "EPSG:2154",
    "+proj=lcc +lat_1=49 +lat_2=44 +lat_0=46.5 +lon_0=3 +x_0=700000 +y_0=6600000 +ellps=GRS80 +units=m +no_defs",
  );

  const couleur = (valeur: number) => {
    if (valeur < 0) return "#2166ac";
    if (valeur < 2) return "#92c5de";
    if (valeur < 4) return "#fdae61";
    return "#d7191c";
  };

  const initializeHeatMaps = () => {
    document.querySelectorAll<HTMLElement>("[data-heat-map]").forEach((conteneur) => {
      if (maps.has(conteneur)) return;

      const statut = conteneur.querySelector<HTMLElement>(".heat-map-status");
      const carteDiv = conteneur.querySelector<HTMLElement>(".heat-map");
      const bilanStatut = document.querySelector<HTMLElement>("[data-heat-summary-status]");
      if (!statut || !carteDiv) return;

      const carte = L.map(carteDiv, { scrollWheelZoom: false }).setView([44.86, -0.58], 11);
      maps.set(conteneur, carte);

      L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
      }).addTo(carte);

      void (async () => {
        try {
          const donneesParCommune = await Promise.all(
            communes.map(async (commune) => {
              const url =
                "https://datahub.bordeaux-metropole.fr/api/explore/v2.1/catalog/datasets/ri_icu_ifu_s/exports/json" +
                "?where=" +
                encodeURIComponent(`insee=${commune.code}`) +
                "&limit=10000";
              const reponse = await fetch(url);

              if (!reponse.ok) {
                throw new Error(`Erreur API pour ${commune.nom} : HTTP ${reponse.status}`);
              }

              const donnees = (await reponse.json()) as ApiZone[];
              return donnees.map((donnee) => ({ ...donnee, nom_commune: commune.nom }));
            }),
          );

          const valeursBordeaux = donneesParCommune[0]
            .filter((donnee) => String(donnee.insee) === "33063")
            .map((donnee) => Number(donnee.delta))
            .filter(Number.isFinite);

          if (valeursBordeaux.length === 0) {
            if (bilanStatut) {
              bilanStatut.textContent = "Aucune valeur exploitable trouvée pour Bordeaux.";
            }
          } else {
            const total = valeursBordeaux.length;
            const formatterPourcentage = new Intl.NumberFormat("fr-FR", {
              maximumFractionDigits: 1,
            });
            const mettreAJourIndicateur = (seuil: "2" | "4", nombre: number) => {
              const valeur = document.querySelector<HTMLElement>(
                `[data-heat-count="${seuil}"]`,
              );
              const pourcentage = document.querySelector<HTMLElement>(
                `[data-heat-percent="${seuil}"]`,
              );
              if (valeur) valeur.textContent = String(nombre);
              if (pourcentage) {
                pourcentage.textContent = formatterPourcentage.format((100 * nombre) / total);
              }
            };

            mettreAJourIndicateur(
              "2",
              valeursBordeaux.filter((valeur) => valeur > 2).length,
            );
            mettreAJourIndicateur(
              "4",
              valeursBordeaux.filter((valeur) => valeur > 4).length,
            );
            document.querySelectorAll<HTMLElement>("[data-heat-total]").forEach((element) => {
              element.textContent = String(total);
            });
            if (bilanStatut) bilanStatut.textContent = `${total} zones de Bordeaux analysées.`;
          }

          const zones: GeoJSON.Feature<GeoJSON.Geometry, HeatProperties>[] = donneesParCommune
            .flat()
            .flatMap((donnee) => {
              const forme = donnee.geo_shape;
              if (!forme || typeof forme !== "object") return [];

              const candidate = "geometry" in forme ? forme.geometry : forme;
              if (!candidate || typeof candidate !== "object" || !("type" in candidate)) return [];

              const valeur = Number(donnee.delta);
              if (!Number.isFinite(valeur)) return [];

              return [
                {
                  type: "Feature",
                  geometry: candidate as GeoJSON.Geometry,
                  properties: {
                    valeur,
                    commune: donnee.nom_commune,
                    date: donnee.date_releve ?? "Non renseignée",
                    identifiant: String(donnee.gid ?? "Non renseigné"),
                  },
                },
              ];
            });

          if (zones.length === 0) {
            throw new Error("Aucune zone géographique exploitable n’a été récupérée.");
          }

          const couche = L.geoJSON(
            { type: "FeatureCollection", features: zones },
            {
              style: (feature) => ({
                color: "#ffffff",
                weight: 0.5,
                fillColor: couleur(feature?.properties.valeur ?? 0),
                fillOpacity: 0.75,
              }),
              onEachFeature: (feature, layer) => {
                const p = feature.properties;
                const contenu =
                  `<strong>${p.commune}</strong><br>` +
                  `Écart de température : ${p.valeur} °C<br>` +
                  `Date du relevé : ${p.date}`;
                layer.bindTooltip(contenu, { sticky: true }).bindPopup(contenu);
              },
            },
          ).addTo(carte);

          carte.fitBounds(couche.getBounds(), { padding: [15, 15] });
          statut.textContent = `${zones.length} zones affichées. Survolez ou cliquez sur une zone pour lire sa valeur.`;
          requestAnimationFrame(() => carte.invalidateSize());
        } catch (erreur) {
          if (bilanStatut) {
            bilanStatut.textContent =
              "Impossible de calculer les indicateurs : " +
              (erreur instanceof Error ? erreur.message : String(erreur));
          }
          statut.textContent =
            "Impossible de charger les données : " +
            (erreur instanceof Error ? erreur.message : String(erreur));
          console.error(erreur);
        }
      })();
    });
  };

  const echapperHtml = (valeur: unknown) =>
    String(valeur).replace(/[&<>"']/g, (caractere) => {
      const entites: Record<string, string> = {
        "&": "&amp;",
        "<": "&lt;",
        ">": "&gt;",
        '"': "&quot;",
        "'": "&#39;",
      };
      return entites[caractere];
    });

  const initializeInstallationMaps = () => {
    document.querySelectorAll<HTMLElement>("[data-installation-map]").forEach((conteneur) => {
      if (installationMaps.has(conteneur)) return;

      const statut = conteneur.querySelector<HTMLElement>(".installation-map-status");
      const carteDiv = conteneur.querySelector<HTMLElement>(".installation-map");
      if (!statut || !carteDiv) return;

      const carte = L.map(carteDiv, { scrollWheelZoom: false });
      installationMaps.set(conteneur, carte);

      void (async () => {
        try {
          const reponse = await fetch(
            "https://geo.api.gouv.fr/communes/33063?format=geojson&geometry=contour",
          );
          if (!reponse.ok) {
            throw new Error(`Impossible de récupérer le contour de Bordeaux : HTTP ${reponse.status}`);
          }

          const contour = await reponse.json();
          if (!contour?.geometry) {
            throw new Error("Le contour de Bordeaux est absent ou invalide.");
          }

          const installations = JSON.parse(conteneur.dataset.installations || "[]") as {
            x: number | string;
            y: number | string;
            nom_ets?: string;
            lib_naf?: string;
            adresse?: string;
          }[];

          L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
            attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
          }).addTo(carte);

          const coucheContour = L.geoJSON(contour, {
            style: {
              color: "#315b45",
              weight: 2,
              fillColor: "#dce9df",
              fillOpacity: 0.45,
            },
          }).addTo(carte);

          const limites = coucheContour.getBounds();
          if (limites.isValid()) {
            carte.fitBounds(limites, {
              paddingTopLeft: [15, 65],
              paddingBottomRight: [15, 15],
            });
          } else {
            carte.setView([44.8378, -0.5792], 12);
          }

          let pointsAffiches = 0;
          installations.forEach((installation) => {
            const x = Number(installation.x);
            const y = Number(installation.y);
            if (!Number.isFinite(x) || !Number.isFinite(y)) return;

            const [longitude, latitude] = proj4("EPSG:2154", "EPSG:4326", [x, y]);
            if (
              !Number.isFinite(latitude) ||
              !Number.isFinite(longitude) ||
              latitude <= 44.7 ||
              latitude >= 45 ||
              longitude <= -0.8 ||
              longitude >= -0.4
            ) {
              return;
            }

            const contenu =
              `<div style="display:inline-block;width:max-content;max-width:280px;white-space:normal;overflow-wrap:anywhere;line-height:1.5">` +
              `<strong>${echapperHtml(installation.nom_ets || "Nom non renseigné")}</strong><br>` +
              `<b>Secteur :</b> ${echapperHtml(installation.lib_naf || "Secteur non renseigné")}<br>` +
              `<b>Adresse :</b> ${echapperHtml(installation.adresse || "Adresse non renseignée")}` +
              `</div>`;

            L.circleMarker([latitude, longitude], {
              radius: 6,
              color: "#ffffff",
              weight: 1.5,
              fillColor: "#c43d32",
              fillOpacity: 0.95,
            })
              .bindTooltip(contenu, { direction: "top", sticky: true })
              .bindPopup(contenu)
              .addTo(carte);
            pointsAffiches += 1;
          });

          statut.textContent =
            pointsAffiches === 0
              ? "Aucun point géolocalisé n’a été trouvé pour les installations de Bordeaux."
              : `${pointsAffiches} installations localisées. Survolez ou cliquez sur un point pour en savoir plus.`;
          requestAnimationFrame(() => carte.invalidateSize());
        } catch (erreur) {
          statut.textContent =
            "Impossible de charger la carte des installations : " +
            (erreur instanceof Error ? erreur.message : String(erreur));
          console.error(erreur);
        }
      })();
    });
  };

  const initializeMaps = () => {
    initializeHeatMaps();
    initializeInstallationMaps();
  };

  document.addEventListener("DOMContentLoaded", initializeMaps, { once: true });
  document.addEventListener("astro:page-load", initializeMaps);
  document.addEventListener("astro:before-swap", () => {
    maps.forEach((carte) => carte.remove());
    maps.clear();
    installationMaps.forEach((carte) => carte.remove());
    installationMaps.clear();
  });
  if (document.readyState !== "loading") initializeMaps();
</script>

<Layout title="Exploration des risques">
  <article class="pt-12 sm:pt-20">
    <header class="max-w-3xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-orange-700">
        01 · Exploration
      </p>
      <h1 class="whitespace-nowrap text-[clamp(1.125rem,5.6vw,3.75rem)] font-semibold tracking-tight text-slate-900">
        Où les risques se concentrent-ils ?
      </h1>
      <p class="mt-6 text-lg leading-8 text-slate-600">
        La chaleur urbaine ne se répartit pas uniformément. À Bordeaux et dans les communes
        voisines, les relevés de 2022 dessinent une géographie contrastée des zones plus
        chaudes ou plus fraîches. Une seconde carte situe les installations industrielles
        recensées dans la ville : deux phénomènes à observer côte à côte, sans les confondre.
      </p>
    </header>

    <figure class="mt-12">
      <div
        class="w-full font-sans"
        data-heat-map
        aria-label="Carte des îlots de chaleur et de fraîcheur à Bordeaux, Le Bouscat et Bruges"
      >
        <h2 class="mb-2 text-xl font-semibold text-slate-900">
          Îlots de chaleur : Bordeaux, Le Bouscat et Bruges
        </h2>
        <p class="heat-map-status mb-3 text-sm text-slate-600" role="status" aria-live="polite">
          Chargement des données…
        </p>
        <div class="heat-map z-0 h-[600px] w-full rounded border border-slate-300 bg-slate-200"></div>
        <figcaption class="mt-2 text-xs text-slate-500">
          Source : Bordeaux Métropole, données 2022 sur les îlots de chaleur et de fraîcheur
          urbains. Les teintes bleues signalent un écart négatif, les rouges un écart positif ;
          le détail apparaît au survol ou au clic.
        </figcaption>
      </div>
    </figure>

    <section class="mt-12 max-w-3xl" aria-labelledby="heat-reading-title">
      <h2 id="heat-reading-title" class="text-2xl font-semibold tracking-tight text-slate-900">
        Une chaleur qui ne s’arrête pas aux frontières communales
      </h2>
      <p class="mt-4 leading-7 text-slate-600">
       Les températures ne sont pas les mêmes partout : la carte montre des zones plus chaudes et d’autres plus fraîches. En observant Bordeaux, Le Bouscat et Bruges, on remarque que ces différences se prolongent au-delà des limites entre les communes. Chaque zone colorée correspond à un secteur de relevé. En passant la souris dessus ou en cliquant, on peut consulter son écart de température en degrés Celsius.
      </p>
      <p class="mt-4 leading-7 text-slate-600">
        Ces données correspondent à la situation observée en 2022. Elles ne permettent donc pas de prévoir les températures futures ni de savoir précisément à quel point chaque habitant est exposé à la chaleur. Elles donnent toutefois un premier aperçu des endroits où la chaleur urbaine est plus ou moins marquée.
      </p>
    </section>

    <section class="mt-16 grid gap-8 lg:grid-cols-[1fr_1.2fr]" aria-labelledby="heat-threshold-title">
      <div class="max-w-3xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-orange-700">
          À l’échelle de Bordeaux
        </p>
        <h2 id="heat-threshold-title" class="text-3xl font-semibold tracking-tight text-slate-900">
          Combien de zones dépassent les seuils de chaleur ?
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          La carte montre où les écarts se dessinent ; ces deux repères en donnent la mesure
          à l’échelle de Bordeaux. Parmi les zones pour lesquelles une valeur est disponible,
          ils comptent celles où l’écart dépasse 2 °C, puis celles où il dépasse 4 °C.
          Les indicateurs sont calculés à partir des relevés 2022 de Bordeaux Métropole.
        </p>
        <p class="mt-4 leading-7 text-slate-600">
          C’est un premier élément de contexte pour notre enquête sur le cumul des expositions
          à Bacalan, pas encore une réponse à l’échelle du quartier. Ces chiffres portent sur
          toute la commune et comptent des zones, non des habitants : ils ne permettent donc
          pas de déduire combien de Bacalanais sont concernés ni de décrire leur exposition
          individuelle.
        </p>
      </div>

      <figure class="h-fit rounded border border-slate-200 bg-[#eef1ef] p-4">
        <figcaption class="mb-1 text-lg font-semibold text-slate-900">
          Zones de chaleur à Bordeaux
        </figcaption>
        <p class="mb-5 text-sm text-slate-600">
          Nombre de zones où l’écart de température dépasse chaque seuil
        </p>
        <p
          class="mb-3 text-sm text-slate-600"
          data-heat-summary-status
          role="status"
          aria-live="polite"
        >
          Chargement des indicateurs…
        </p>
        <div class="grid gap-3 sm:grid-cols-2">
          <div class="rounded-lg bg-[#fff0df] p-4">
            <p class="text-sm text-slate-700">Écart supérieur à 2 °C</p>
            <p class="mt-1 text-sm text-slate-700">
              <strong class="text-3xl font-bold text-[#b85c00]" data-heat-count="2">—</strong>
              zones sur <span data-heat-total>—</span>
            </p>
            <p class="mt-1 text-sm text-slate-700">
              <span data-heat-percent="2">—</span> % des zones
            </p>
          </div>
          <div class="rounded-lg bg-[#ffe2e2] p-4">
            <p class="text-sm text-slate-700">Écart supérieur à 4 °C</p>
            <p class="mt-1 text-sm text-slate-700">
              <strong class="text-3xl font-bold text-[#c62828]" data-heat-count="4">—</strong>
              zones sur <span data-heat-total>—</span>
            </p>
            <p class="mt-1 text-sm text-slate-700">
              <span data-heat-percent="4">—</span> % des zones
            </p>
          </div>
        </div>
        <p class="mt-4 text-xs leading-5 text-slate-500">
          Source : Bordeaux Métropole, jeu de données ri_icu_ifu_s, données 2022.
          Bordeaux uniquement — code INSEE 33063.
        </p>
      </figure>
    </section>

    <section class="mt-16" aria-labelledby="installations-map-title">
      <div class="max-w-3xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-orange-700">
          Repères à Bordeaux
        </p>
        <h2 id="installations-map-title" class="text-3xl font-semibold tracking-tight text-slate-900">
          Où se trouvent les installations industrielles ?
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          Les points rouges localisent les établissements répertoriés dans les données
          disponibles pour Bordeaux. Leur dispersion donne à voir la présence de ces
          activités dans la ville, tandis que le contour vert rappelle le périmètre communal.
          Sélectionnez un point pour consulter le nom de l’établissement, son secteur et son
          adresse lorsqu’elle est renseignée.
        </p>
      </div>

      <figure class="mt-6">
        <div
          class="relative h-[600px] w-full overflow-hidden rounded border border-slate-300 bg-slate-200"
          data-installation-map
          data-installations={JSON.stringify(installations)}
          aria-label="Carte des installations industrielles recensées à Bordeaux"
          role="group"
        >
          <div
            class="pointer-events-none absolute left-1/2 top-8 z-[1000] -translate-x-1/2 font-sans text-lg font-extrabold tracking-[0.2em] text-[#263d32] [text-shadow:1px_1px_white,-1px_-1px_white,1px_-1px_white,-1px_1px_white]"
            aria-hidden="true"
          >
            BORDEAUX
          </div>
          <p
            class="installation-map-status absolute bottom-2 left-2 z-[1000] m-0 max-w-[calc(100%-1rem)] rounded bg-white/95 px-3 py-2 text-sm text-slate-700 shadow"
            role="status"
            aria-live="polite"
          >
            Chargement des installations…
          </p>
          <div class="installation-map h-full w-full"></div>
        </div>
        <figcaption class="mt-2 text-xs text-slate-500">
          Sources : inventaire des installations industrielles en Gironde, filtré sur le code
          INSEE 33063 ; contour communal : geo.api.gouv.fr ; fond cartographique : OpenStreetMap.
          Les coordonnées en Lambert-93 ont été converties pour l’affichage.
        </figcaption>
      </figure>
      <p class="mt-4 max-w-3xl leading-7 text-slate-600">
        Cette carte situe des établissements, pas leurs émissions ni leurs effets sur la
        population. La proximité spatiale avec les zones de chaleur ne suffit pas à établir
        un lien de cause à effet ; elle permet plutôt de poser les bonnes questions pour une
        analyse plus approfondie.
      </p>
    </section>

    <section class="mt-20 grid gap-10 lg:grid-cols-[1fr_1.5fr]" aria-labelledby="sectors-title">
      <div>
        <h2 id="sectors-title" class="text-3xl font-semibold tracking-tight text-slate-900">
          Des installations aux secteurs variés
        </h2>
        <p class="mt-4 leading-7 text-slate-600">
          La carte localise les établissements ; ce classement en donne une autre lecture,
          par activité. Il présente les dix secteurs les plus représentés dans l’inventaire
          bordelais. Les barres comptent des installations : elles ne mesurent ni leurs
          émissions ni leur niveau de danger.
        </p>
      </div>

      <figure class="rounded border border-slate-200 bg-[#eef1ef] p-4">
        <figcaption class="mb-4 text-sm text-slate-600">
          Nombre d’installations par secteur d’activité
        </figcaption>
        <PlotFigure
          options={{
            height: 440,
            marginLeft: 210,
            x: { grid: true, label: "Installations" },
            y: { domain: sectors.map(({ sector }) => sector), label: null },
            marks: [
              Plot.barX(sectors, { x: "count", y: "sector", fill: "#2563eb", sort: { y: "-x" } }),
              Plot.text(sectors, { x: "count", y: "sector", text: "count", dx: 5, textAnchor: "start" }),
              Plot.ruleX([0]),
            ],
          }}
        />
      </figure>
    </section>
  </article>
</Layout>
