---
import PlotFigure from "../components/PlotFigure.astro";
import * as Plot from "@observablehq/plot";
const penguins = [];
---

  <PlotFigure
    options={{
      marks: [
        Plot.dot(penguins, {
          x: "culmen_length_mm",
          y: "culmen_depth_mm",
          stroke: "species",
        }),
      ],
    }}
  />