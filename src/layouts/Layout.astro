---
import "../styles/global.css";
const { title = "Accueil" } = Astro.props;
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body class="bg-[#f7f5f0] font-[Arial,sans-serif] text-[#1e2b2a]">
    <main
      class="mx-auto box-border min-h-screen w-full max-w-[1180px] px-6 py-6 sm:px-[6vw] sm:py-8"
    >
      <nav
        aria-label="Navigation principale"
        class="flex flex-wrap gap-x-6 gap-y-2 border-b border-slate-300 pb-4"
      >
        <a
          href="/"
          class="text-sm font-medium text-slate-700 no-underline transition-colors hover:text-orange-700"
        >
          Accueil
        </a>
        <a
          href="/exploration"
          class="text-sm font-medium text-slate-700 no-underline transition-colors hover:text-orange-700"
        >
          Exploration
        </a>
        <a href="/revelation" class="text-sm font-medium text-slate-700 no-underline transition-colors hover:text-orange-700">Révélation</a>
        <a href="/conclusion" class="text-sm font-medium text-slate-700 no-underline transition-colors hover:text-orange-700">Conclusion</a>
        <a href="/methode" class="text-sm font-medium text-slate-700 no-underline transition-colors hover:text-orange-700">Méthode</a>
      </nav>
      <slot />
    </main>
  </body>
</html>
